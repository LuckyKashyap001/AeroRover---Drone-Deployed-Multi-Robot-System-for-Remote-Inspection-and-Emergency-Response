// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println(
    "================================"
  );

  Serial.println(
    "DRAINGUARD STARTING..."
  );

  Serial.println(
    "================================"
  );


  // ----------------------------------------------------------
  // ANALOG CONFIGURATION
  // ----------------------------------------------------------

  analogReadResolution(12);


  // ----------------------------------------------------------
  // I2C
  // ----------------------------------------------------------

  Wire.begin(
    I2C_SDA,
    I2C_SCL
  );


  // ----------------------------------------------------------
  // SENSOR PINS
  // ----------------------------------------------------------

  pinMode(
    MOISTURE_PIN,
    INPUT
  );

  pinMode(
    GAS_PIN,
    INPUT
  );

  pinMode(
    BATTERY_PIN,
    INPUT
  );


  // ----------------------------------------------------------
  // ULTRASONIC
  // ----------------------------------------------------------

  pinMode(
    TRIG_PIN,
    OUTPUT
  );

  pinMode(
    ECHO_PIN,
    INPUT
  );


  // ----------------------------------------------------------
  // MOTOR PINS
  // ----------------------------------------------------------

  pinMode(
    MOTOR_LEFT_IN1,
    OUTPUT
  );

  pinMode(
    MOTOR_LEFT_IN2,
    OUTPUT
  );

  pinMode(
    MOTOR_RIGHT_IN1,
    OUTPUT
  );

  pinMode(
    MOTOR_RIGHT_IN2,
    OUTPUT
  );

  stopRobot();


  // ----------------------------------------------------------
  // BME280
  // ----------------------------------------------------------

  bool bmeStatus =
    bme.begin(0x76);

  if(!bmeStatus) {

    Serial.println(
      "BME280 not found!"
    );

  } else {

    Serial.println(
      "BME280 connected"
    );
  }


  // ----------------------------------------------------------
  // CAMERA
  // ----------------------------------------------------------

  if(!initCamera()) {

    Serial.println(
      "Camera failed!"
    );

  }


  // ----------------------------------------------------------
  // WIFI
  // ----------------------------------------------------------

  WiFi.mode(
    WIFI_STA
  );

  WiFi.begin(
    ssid,
    password
  );

  Serial.print(
    "Connecting to WiFi"
  );

  unsigned long wifiStart =
    millis();

  while(
    WiFi.status() != WL_CONNECTED
  ) {

    delay(500);

    Serial.print(".");

    if(
      millis() - wifiStart >
      20000
    ) {

      Serial.println(
        "\nWiFi timeout"
      );

      break;
    }
  }


  if(
    WiFi.status() ==
    WL_CONNECTED
  ) {

    Serial.println();

    Serial.println(
      "WiFi Connected!"
    );

    Serial.print(
      "DrainGuard Dashboard: http://"
    );

    Serial.println(
      WiFi.localIP()
    );
  }


  // ----------------------------------------------------------
  // WEB ROUTES
  // ----------------------------------------------------------

  server.on(
    "/",
    HTTP_GET,
    handleRoot
  );


  server.on(
    "/telemetry",
    HTTP_GET,
    handleTelemetry
  );


  server.on(
    "/camera",
    HTTP_GET,
    handleCamera
  );


  server.on(
    "/control",
    HTTP_GET,
    handleControl
  );


  server.begin();

  Serial.println(
    "DrainGuard Web Server Started"
  );
}


// ============================================================
// MAIN LOOP
// ============================================================

void loop() {

  server.handleClient();

  delay(5);
}