=============================================================
 EDGE IMPULSE MODEL

 Replace this filename with the header generated by
 your downloaded Edge Impulse Arduino library.

 Example:

 #include <DrainGuard_Blockage_inferencing.h>

=============================================================
*/

#include <your_drainguard_inferencing.h>


// ============================================================
// WIFI SETTINGS
// ============================================================

const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

WebServer server(80);


// ============================================================
// XIAO ESP32S3 SENSE CAMERA PINS
// ============================================================

#define PWDN_GPIO_NUM    -1
#define RESET_GPIO_NUM   -1

#define XCLK_GPIO_NUM    10
#define SIOD_GPIO_NUM    40
#define SIOC_GPIO_NUM    39

#define Y9_GPIO_NUM      48
#define Y8_GPIO_NUM      11
#define Y7_GPIO_NUM      12
#define Y6_GPIO_NUM      14
#define Y5_GPIO_NUM      16
#define Y4_GPIO_NUM      18
#define Y3_GPIO_NUM      17
#define Y2_GPIO_NUM      15

#define VSYNC_GPIO_NUM   38
#define HREF_GPIO_NUM    47
#define PCLK_GPIO_NUM    13


// ============================================================
// I2C PINS
// ============================================================

#define I2C_SDA 5
#define I2C_SCL 6


// ============================================================
// SENSOR PINS
// ============================================================

// Change these according to your final wiring.

#define MOISTURE_PIN 1
#define GAS_PIN      2
#define BATTERY_PIN  3


// ============================================================
// ULTRASONIC SENSOR
// ============================================================

#define TRIG_PIN 4
#define ECHO_PIN 7


// ============================================================
// MOTOR DRIVER PINS
// ============================================================

// IMPORTANT:
// Assign according to your available GPIO pins
// and motor driver wiring.

#define MOTOR_LEFT_IN1   8
#define MOTOR_LEFT_IN2   9

#define MOTOR_RIGHT_IN1  41
#define MOTOR_RIGHT_IN2  42


// ============================================================
// BME280
// ============================================================

Adafruit_BME280 bme;


// ============================================================
// DEVICE STATE
// ============================================================

String robotStatus = "STANDBY";
String movement = "STOP";


// ============================================================
// SENSOR DATA
// ============================================================

float temperature = 0;
float humidity = 0;
float pressure = 0;

int moistureLevel = 0;
int gasValue = 0;

float distanceCM = 0;

float batteryVoltage = 0;
int batteryPercent = 0;


// ============================================================
// AI DATA
// ============================================================

String blockageLevel = "SCANNING";
String blockageStatus = "WAITING";
float aiConfidence = 0;

String detectedClass = "NONE";

unsigned long lastInference = 0;

const unsigned long INFERENCE_INTERVAL = 2500;


// ============================================================
// CAMERA INITIALIZATION
// ============================================================

bool initCamera() {

  camera_config_t config;

  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;

  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;

  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;

  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;

  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;

  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;

  config.xclk_freq_hz = 20000000;

  config.pixel_format = PIXFORMAT_JPEG;

  if(psramFound()) {

    config.frame_size = FRAMESIZE_QVGA;
    config.jpeg_quality = 12;
    config.fb_count = 2;

  } else {

    config.frame_size = FRAMESIZE_QQVGA;
    config.jpeg_quality = 15;
    config.fb_count = 1;
  }

  esp_err_t err = esp_camera_init(&config);

  if(err != ESP_OK) {

    Serial.printf(
      "Camera initialization failed: 0x%x\n",
      err
    );

    return false;
  }

  Serial.println("Camera initialized successfully");

  return true;
}


// ============================================================
// READ BME280
// ============================================================

void readBME280() {

  temperature =
    bme.readTemperature();

  humidity =
    bme.readHumidity();

  pressure =
    bme.readPressure() / 100.0F;
}


// ============================================================
// READ MOISTURE
// ============================================================

void readMoisture() {

  int rawValue =
    analogRead(MOISTURE_PIN);

  moistureLevel =
    map(
      rawValue,
      0,
      4095,
      100,
      0
    );

  moistureLevel =
    constrain(
      moistureLevel,
      0,
      100
    );
}


// ============================================================
// READ GAS SENSOR
// ============================================================

void readGas() {

  gasValue =
    analogRead(GAS_PIN);
}


// ============================================================
// READ BATTERY
// ============================================================

void readBattery() {

  int raw =
    analogRead(BATTERY_PIN);

  /*
   Adjust multiplier according
   to your voltage divider.
  */

  batteryVoltage =
    ((float)raw / 4095.0) *
    3.3 *
    2.0;

  batteryPercent =
    map(
      (int)(batteryVoltage * 100),
      330,
      420,
      0,
      100
    );

  batteryPercent =
    constrain(
      batteryPercent,
      0,
      100
    );
}


// ============================================================
// READ ULTRASONIC SENSOR
// ============================================================

void readDistance() {

  digitalWrite(
    TRIG_PIN,
    LOW
  );

  delayMicroseconds(2);

  digitalWrite(
    TRIG_PIN,
    HIGH
  );

  delayMicroseconds(10);

  digitalWrite(
    TRIG_PIN,
    LOW
  );

  long duration =
    pulseIn(
      ECHO_PIN,
      HIGH,
      30000
    );

  if(duration > 0) {

    distanceCM =
      duration * 0.0343 / 2.0;
  }
}


// ============================================================
// READ ALL SENSORS
// ============================================================

void updateSensors() {

  readBME280();

  readMoisture();

  readGas();

  readBattery();

  readDistance();
}


// ============================================================
// ROBOT MOVEMENT
// ============================================================

void stopRobot() {

  digitalWrite(MOTOR_LEFT_IN1, LOW);
  digitalWrite(MOTOR_LEFT_IN2, LOW);

  digitalWrite(MOTOR_RIGHT_IN1, LOW);
  digitalWrite(MOTOR_RIGHT_IN2, LOW);

  movement = "STOPPED";
}


void moveForward() {

  digitalWrite(MOTOR_LEFT_IN1, HIGH);
  digitalWrite(MOTOR_LEFT_IN2, LOW);

  digitalWrite(MOTOR_RIGHT_IN1, HIGH);
  digitalWrite(MOTOR_RIGHT_IN2, LOW);

  movement = "FORWARD";
}


void moveBackward() {

  digitalWrite(MOTOR_LEFT_IN1, LOW);
  digitalWrite(MOTOR_LEFT_IN2, HIGH);

  digitalWrite(MOTOR_RIGHT_IN1, LOW);
  digitalWrite(MOTOR_RIGHT_IN2, HIGH);

  movement = "REVERSE";
}


void turnLeft() {

  digitalWrite(MOTOR_LEFT_IN1, LOW);
  digitalWrite(MOTOR_LEFT_IN2, HIGH);

  digitalWrite(MOTOR_RIGHT_IN1, HIGH);
  digitalWrite(MOTOR_RIGHT_IN2, LOW);

  movement = "LEFT";
}


void turnRight() {

  digitalWrite(MOTOR_LEFT_IN1, HIGH);
  digitalWrite(MOTOR_LEFT_IN2, LOW);

  digitalWrite(MOTOR_RIGHT_IN1, LOW);
  digitalWrite(MOTOR_RIGHT_IN2, HIGH);

  movement = "RIGHT";
}


// ============================================================
// EDGE IMPULSE IMAGE BUFFER
// ============================================================

camera_fb_t *aiFrame = NULL;


// ============================================================
// CAPTURE IMAGE FOR AI
// ============================================================

bool cameraCaptureForAI(
  size_t offset,
  size_t length,
  float *out_ptr
) {

  if(aiFrame == NULL) {
    return false;
  }

  size_t pixelIndex =
    offset * 3;

  for(
    size_t i = 0;
    i < length;
    i++
  ) {

    if(
      pixelIndex + 2 >=
      aiFrame->len
    ) {
      return false;
    }

    uint8_t r =
      aiFrame->buf[pixelIndex];

    uint8_t g =
      aiFrame->buf[pixelIndex + 1];

    uint8_t b =
      aiFrame->buf[pixelIndex + 2];

    out_ptr[i] =
      (r << 16) |
      (g << 8) |
      b;

    pixelIndex += 3;
  }

  return true;
}


// ============================================================
// RUN AI MODEL
// ============================================================

void runBlockageAI() {

  if(
    millis() - lastInference <
    INFERENCE_INTERVAL
  ) {
    return;
  }

  lastInference = millis();

  /*
   NOTE:

   A production Edge Impulse image model normally
   requires a correctly formatted RGB buffer.

   Depending on your exported model, the image capture
   and conversion code may differ.

   This section provides the integration architecture.
  */

  Serial.println(
    "Running blockage AI..."
  );


  /*
   ----------------------------------------------------
   YOUR MODEL-SPECIFIC INFERENCE CODE GOES HERE
   ----------------------------------------------------

   Example conceptual workflow:

   1. Capture camera frame
   2. Convert frame to RGB888
   3. Resize to EI_CLASSIFIER_INPUT_WIDTH
      x EI_CLASSIFIER_INPUT_HEIGHT
   4. Create signal_t
   5. Call run_classifier()
   6. Read classification results

   Example:

   signal_t signal;
   ei_impulse_result_t result;

   signal.total_length =
     EI_CLASSIFIER_DSP_INPUT_FRAME_SIZE;

   signal.get_data =
     &cameraCaptureForAI;

   EI_IMPULSE_ERROR res =
     run_classifier(
       &signal,
       &result,
       false
     );

   ----------------------------------------------------
  */


  /*
   TEMPORARY SENSOR + DEMO LOGIC

   Replace this section with results
   from your trained ML model.
  */

  if(distanceCM < 10) {

    detectedClass =
      "FULL_BLOCKAGE";

    blockageLevel =
      "CRITICAL";

    blockageStatus =
      "Drain Severely Blocked";

    aiConfidence =
      92.0;

  }
  else if(distanceCM < 25) {

    detectedClass =
      "HIGH_BLOCKAGE";

    blockageLevel =
      "HIGH";

    blockageStatus =
      "Major Obstruction Detected";

    aiConfidence =
      87.0;

  }
  else if(distanceCM < 50) {

    detectedClass =
      "MEDIUM_BLOCKAGE";

    blockageLevel =
      "MEDIUM";

    blockageStatus =
      "Partial Obstruction";

    aiConfidence =
      81.0;

  }
  else {

    detectedClass =
      "CLEAR";

    blockageLevel =
      "LOW";

    blockageStatus =
      "Drain Passage Appears Clear";

    aiConfidence =
      95.0;
  }


  // --------------------------------------------------
  // ADDITIONAL HAZARD LOGIC
  // --------------------------------------------------

  if(gasValue > 2500) {

    robotStatus =
      "GAS HAZARD DETECTED";

  }
  else if(blockageLevel == "CRITICAL") {

    robotStatus =
      "CRITICAL BLOCKAGE";

  }
  else if(batteryPercent < 20) {

    robotStatus =
      "LOW BATTERY";

  }
  else {

    robotStatus =
      "INSPECTING";
  }
}


// ============================================================
// LIVE CAMERA IMAGE
// ============================================================

void handleCamera() {

  camera_fb_t *fb =
    esp_camera_fb_get();

  if(!fb) {

    server.send(
      500,
      "text/plain",
      "Camera capture failed"
    );

    return;
  }

  server.sendHeader(
    "Content-Type",
    "image/jpeg"
  );

  server.sendHeader(
    "Content-Length",
    String(fb->len)
  );

  server.send_P(
    200,
    "image/jpeg",
    (const char*)fb->buf,
    fb->len
  );

  esp_camera_fb_return(fb);
}


// ============================================================
// TELEMETRY JSON
// ============================================================

void handleTelemetry() {

  updateSensors();

  runBlockageAI();

  String json = "{";

  json +=
    "\"temperature\":" +
    String(temperature, 1) + ",";

  json +=
    "\"humidity\":" +
    String(humidity, 1) + ",";

  json +=
    "\"pressure\":" +
    String(pressure, 1) + ",";

  json +=
    "\"moisture\":" +
    String(moistureLevel) + ",";

  json +=
    "\"gas\":" +
    String(gasValue) + ",";

  json +=
    "\"distance\":" +
    String(distanceCM, 1) + ",";

  json +=
    "\"battery\":" +
    String(batteryPercent) + ",";

  json +=
    "\"blockageLevel\":\"" +
    blockageLevel + "\",";

  json +=
    "\"detectedClass\":\"" +
    detectedClass + "\",";

  json +=
    "\"blockageStatus\":\"" +
    blockageStatus + "\",";

  json +=
    "\"confidence\":" +
    String(aiConfidence, 1) + ",";

  json +=
    "\"robotStatus\":\"" +
    robotStatus + "\",";

  json +=
    "\"movement\":\"" +
    movement + "\"";

  json += "}";

  server.send(
    200,
    "application/json",
    json
  );
}


// ============================================================
// ROBOT CONTROL API
// ============================================================

void handleControl() {

  String command =
    server.arg("cmd");

  if(command == "forward") {

    moveForward();

  }
  else if(command == "backward") {

    moveBackward();

  }
  else if(command == "left") {

    turnLeft();

  }
  else if(command == "right") {

    turnRight();

  }
  else {

    stopRobot();
  }

  server.send(
    200,
    "text/plain",
    movement
  );
}


